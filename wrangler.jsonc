{
  // Küt oyun sunucusu — Cloudflare Worker + Durable Objects (her oda = bir Durable Object).
  // Depo kökünde durur ki Cloudflare panelindeki varsayılan "npx wrangler deploy" doğrudan çalışsın.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kut-americano",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // Ücretsiz planda sadece SQLite tabanlı Durable Object kullanılabilir
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "vars": {
    // Virgülle ayrılmış izinli kökenler (boşsa hepsi). Yerel geliştirme için localhost da açık.
    "ALLOWED_ORIGINS": "https://thorehan.github.io,https://kuralokey.com,http://localhost:5173,capacitor://localhost,https://localhost"
  },
  // Kendi alan adımız: *.workers.dev Türkiye'de engelli. Cloudflare DNS kaydını ve sertifikayı kendisi kurar.
  // routes tanımlıyken workers.dev varsayılan olarak kapanır; yurt dışı/yedek bağlantı için açık kalsın.
  "workers_dev": true,
  "routes": [{ "pattern": "api.kuralokey.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
